// World Dominion — database schema
// SQLite for local dev; switchable to PostgreSQL for Render deployment
// (see scripts/prisma-setup.mjs and README.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  nick         String
  nickLower    String   @unique @map("nick_lower")
  passwordHash String   @map("password_hash")
  deviceId     String?  @map("device_id")
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")

  save        Save?
  score       Score?
  wallet      Wallet?
  sessions    Session[]
  territories Territory[]
  grants      AdminGrant[]
  weeklyClaims WeeklyClaim[]
  chatMessages WorldChat[]
  passes       SeasonPass[]
  abuseReports AbuseReport[] @relation("AbuseReports")
  shopPurchases ShopPurchase[]
  shopInventory  ShopInventory[]

  @@map("users")
}

model Session {
  token     String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Save {
  userId    String   @id @map("user_id")
  nick      String
  state     String
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saves")
}

model Score {
  userId    String @id @map("user_id")
  nick      String
  server    Int    @default(1)
  conquered Int    @default(0)
  score     Int    @default(0)
  kills     Int    @default(0)
  economy   Int    @default(0)
  recruits  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scores")
}

model ServerStat {
  server  Int @id
  taken   Int @default(0)
  players Int @default(0)

  @@map("server_stats")
}

model Territory {
  server    Int
  country   String
  userId    String  @map("user_id")
  nick      String
  isCapital Boolean @default(false) @map("is_capital")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([server, country])
  @@index([userId, server])
  @@map("territories")
}

model AdminGrant {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  gold      Int      @default(0)
  oil       Int      @default(0)
  food      Int      @default(0)
  claimed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_grants")
}

model WorldChat {
  id        Int      @id @default(autoincrement())
  server    Int
  userId    String   @map("user_id")
  nick      String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([server, createdAt])
  @@map("world_chat")
}

model WorldNews {
  id        Int      @id @default(autoincrement())
  server    Int
  action    String
  country   String?
  actorNick String?  @map("actor_nick")
  targetNick String? @map("target_nick")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([server, createdAt])
  @@map("world_news")
}

model Wallet {
  userId    String    @id @map("user_id")
  gems      Int       @default(0)
  boostUntil DateTime? @map("boost_until")
  lastDaily DateTime? @map("last_daily")
  /* V66 Shop V2 — VIP سمت سرور (تک‌منبع اعتبار VIP) */
  vipUntil  DateTime? @map("vip_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/* V66 Shop V2 — دفتر تراکنش خرید: هر خرید یک ردیف با Idempotency (requestId یکتا به‌ازای هر کاربر).
   هیچ خریدی بدون ردیف تراکنش انجام نمی‌شود؛ خرید تکراریِ همان requestId دوباره کسر نمی‌شود. */
model ShopPurchase {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  itemId    String   @map("item_id")
  price     Int      @default(0)
  currency  String   @default("gem")
  status    String   @default("ok") /* ok | failed */
  provider  String   @default("shop") /* shop | mystery | collection | legacy_rpc */
  requestId String?  @map("request_id")
  meta      String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@map("shop_purchases")
}

/* V66 Shop V2 — انباری سمت سرور: تک‌منبع مالکیت آیتم‌های غیرمصرفی (کازمتیک/خدمات/محدود).
   آیتم خدماتی (VIP/رادار) expiresAt دارد؛ آیتم‌های فصلی با شناسه‌ی فصل (@slug) ذخیره می‌شوند. */
model ShopInventory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  itemId    String   @map("item_id")
  source    String   @default("shop") /* shop | mystery | collection | legacy */
  rarity    String   @default("common")
  expiresAt DateTime? @map("expires_at")
  meta      String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, expiresAt])
  @@map("shop_inventory")
}

model WeeklyClaim {
  id         Int    @id @default(autoincrement())
  userId     String @map("user_id")
  weekKey    String @map("week_key")
  category   String
  rank       Int
  rewardGold Int    @map("reward_gold")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey, category])
  @@map("weekly_claims")
}

model TradeOffer {
  id         String   @id @default(cuid())
  server     Int
  ownerUid   String   @map("owner_uid")
  ownerNick  String   @map("owner_nick")
  giveRes    String   @map("give_res")
  giveQty    Int      @map("give_qty")
  wantRes    String   @map("want_res")
  wantQty    Int      @map("want_qty")
  status     String   @default("open")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([server, status, createdAt])
  @@map("trade_offers")
}

model SpecialUse {
  id     String   @id @default(cuid())
  userId String   @map("user_id")
  item   String
  usedAt DateTime @default(now()) @map("used_at")

  @@index([userId, item, usedAt])
  @@map("special_uses")
}

/* V32 — Olympic champion of each 7-day cycle (weekly crowning + real rewards) */
model OlympicChampion {
  id         String   @id @default(cuid())
  server     Int
  cycle      Int
  userId     String   @map("user_id")
  nick       String
  country    String?
  medals     Int      @default(0)
  golds      Int      @default(0)
  rewardGold Int      @default(0) @map("reward_gold")
  rewardGems Int      @default(0) @map("reward_gems")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([server, cycle])
  @@map("olympic_champions")
}

/* V33 — Olympic Games (10 mini-game disciplines, country medal table, records, archive) */
model OlympicEntry {
  id         String   @id @default(cuid())
  edition    Int
  userId     String   @map("user_id")
  nick       String
  country    String?
  countryFa  String?  @map("country_fa")
  discipline String
  best       Int      @default(0)
  attempts   Int      @default(0)
  lastAt     DateTime @default(now()) @map("last_at")

  @@unique([edition, userId, discipline])
  @@index([edition, discipline])
  @@index([edition, discipline, best])
  @@map("olympic_entries")
}

/* O1 — آنتی‌چیت L1/L5/L6: نشست هر مسابقه (seed سرور + nonce + وضعیت) + بازپخش رکوردها */
model OlympicMatch {
  id          String    @id @default(cuid())
  edition     Int
  userId      String    @map("user_id")
  discipline  String
  mode        String    @default("official")
  serverSeed  String    @map("server_seed")
  clientNonce String?   @map("client_nonce")
  score       Int       @default(0)
  flags       String?
  logJson     String?   @map("log_json")
  status      String    @default("open")
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([userId, edition])
  @@index([discipline, score])
  @@map("olympic_matches")
}

/* O1 — آنتی‌چیت L9 / PHASE 29: رکوردهای مشکوک تا تأیید ادمین وارد رتبه رسمی نمی‌شوند */
model OlympicSuspicious {
  id         String   @id @default(cuid())
  matchId    String   @map("match_id")
  edition    Int
  discipline String
  userId     String   @map("user_id")
  nick       String
  countryFa  String?  @map("country_fa")
  score      Int
  reason     String?
  status     String   @default("pending")
  logJson    String?  @map("log_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("olympic_suspicious")
}

model OlympicResult {
  id         String  @id @default(cuid())
  edition    Int
  discipline String
  rank       Int
  userId     String  @map("user_id")
  nick       String
  country    String?
  countryFa  String? @map("country_fa")
  score      Int

  @@unique([edition, discipline, rank])
  @@map("olympic_results")
}

model OlympicRecord {
  discipline String   @id
  score      Int
  nick       String
  country    String?
  edition    Int
  matchId    String?  @map("match_id") /* O2: پیوند به مسابقه‌ی رکورد — منبع Ghost/Replay */
  sv         Int      @default(1) /* O3: نسخه‌ی مقیاس امتیاز (۱=نسل اول، ۲=نسل دوم بی‌کف) */
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("olympic_records")
}

/* O2 — PHASE 3/4/49/50: پروفایل مهارت هر رشته (فقط مسابقه‌ی رسمی) —
   Skill از رینگ ۱۰ رکورد اخیر + میانگین بلندمدت، Consistency از پراکندگی،
   Potential از روند صعودی. هیچ عدد ثابت دستی ذخیره نمی‌شود. */
model OlympicProfile {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  discipline  String
  n           Int      @default(0) /* تعداد مسابقه‌ی رسمی */
  bestEver    Int      @default(0) @map("best_ever") /* PB همه‌ی دوره‌ها */
  bestEdition Int      @default(0) @map("best_edition")
  prCount     Int      @default(0) @map("pr_count")
  bullseyes   Int      @default(0) /* جمع ده‌های طلایی کمان */
  recent      String?  @default("[]") /* رینگ JSON آخرین ۱۰ نتیجه [{s,m,at}] */
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, discipline])
  @@index([discipline])
  @@map("olympic_profiles")
}

/* O2 — PHASE 27: دستاوردهای واقعی (از داده‌ی واقعی مسابقه‌ها، نه دستی) */
model OlympicAchieve {
  id      String   @id @default(cuid())
  userId  String   @map("user_id")
  key     String
  edition Int
  at      DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
  @@map("olympic_achieves")
}

model OlympicArchive {
  id              String   @id @default(cuid())
  edition         Int      @unique
  hostCity        String   @map("host_city")
  hostCountry     String   @map("host_country")
  hostCc          String   @map("host_cc")
  championCountry String?  @map("champion_country")
  championNick    String?  @map("champion_nick")
  medalsJson      String   @map("medals_json")
  tableJson       String   @map("table_json")
  recordsJson     String   @map("records_json")
  participants    Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("olympic_archives")
}

/* O4-final / PHASE 10: دفتر رقابت شخصی ماندگار — رقیب = نفر دقیقاً بالای سرت در
   رتبه‌ی همان رشته‌ی همان دوره. هر «پیشی‌گرفتن» واقعی (با امتیاز رسمی داور) یک
   رویداد pass/fall ثبت می‌کند؛ سری W-L از همین رویدادها ساخته می‌شود.
   کل داده از مسابقه‌ی رسمی می‌آید — تمرین و دستکاری کلاینت اثری ندارد. */
model OlympicRivalry {
  id          String   @id @default(cuid())
  edition     Int
  discipline  String
  userId      String   @map("user_id")
  rivalUserId String   @map("rival_user_id")
  rivalNick   String   @map("rival_nick")
  myBest      Int      @default(0) @map("my_best")
  rivalBest   Int      @default(0) @map("rival_best")
  passes      Int      @default(0) /* دفعاتی که من از او پیشی گرفتم */
  falls       Int      @default(0) /* دفعاتی که او از من پیشی گرفت */
  ahead       Boolean  @default(false)
  historyJson String?  @map("history_json") /* حداکثر ۱۲ رویداد آخر [{t,ev,my,rv}] */
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([edition, userId, discipline])
  @@index([edition, rivalUserId])
  @@map("olympic_rivalries")
}

/* ============ V34 — social & competitive layer ============ */

/* استریک روزانه — consecutive daily login rewards (server-authoritative) */
model DailyStreak {
  userId      String   @id @map("user_id")
  server      Int      @default(1)
  streak      Int      @default(0)
  best        Int      @default(0)
  lastDay     String   @map("last_day")
  totalClaims Int      @default(0) @map("total_claims")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("daily_streaks")
}

/* دعوت دوطرفه — mutual PvP challenge with a 2h war window */
model Duel {
  id         String   @id @default(cuid())
  server     Int
  fromUid    String   @map("from_uid")
  fromNick   String   @map("from_nick")
  toUid      String   @map("to_uid")
  toNick     String   @map("to_nick")
  status     String   @default("open") /* open|live|done|expired|declined */
  winnerUid  String?  @map("winner_uid")
  winnerNick String?  @map("winner_nick")
  pot        Int      @default(0)
  prizeGold  Int      @default(0) @map("prize_gold")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([server, status, createdAt])
  @@map("duels")
}

/* شرط‌بندی روی دوئل‌ها — gold escrowed into the duel pot, proportional payout */
model DuelBet {
  id      String  @id @default(cuid())
  duelId  String  @map("duel_id")
  userId  String  @map("user_id")
  nick    String
  onUid   String  @map("on_uid")
  amount  Int
  paid    Int     @default(0)
  settled Boolean @default(false)
  @@unique([duelId, userId])
  @@index([duelId])
  @@map("duel_bets")
}

/* انتقام — one-shot +25% strike right against the player who took your land (72h) */
model RevengeMark {
  id         String   @id @default(cuid())
  server     Int
  userId     String   @map("user_id")
  targetUid  String   @map("target_uid")
  targetNick String   @map("target_nick")
  used       Boolean  @default(false)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([userId, used, expiresAt])
  @@map("revenge_marks")
}

/* Heatmap — battle activity per country for the 48h war-intensity map layer */
model BattleLog {
  id        String   @id @default(cuid())
  server    Int
  kind      String   @default("attack") /* attack|coup|meteor|capture */
  country   String
  attacker  String
  defender  String?
  win       Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([server, createdAt])
  @@map("battle_logs")
}

/* انتخابات جهانی — 10-day cycles: candidacy+voting, winner = world president */
model ElectionCandidate {
  id     String @id @default(cuid())
  server Int
  cycle  Int
  userId String @map("user_id")
  nick   String
  slogan String @default("")
  @@unique([server, cycle, userId])
  @@map("election_candidates")
}
model ElectionVote {
  id     String @id @default(cuid())
  server Int
  cycle  Int
  userId String @map("user_id")
  toUid  String @map("to_uid")
  @@unique([server, cycle, userId])
  @@map("election_votes")
}
model ElectionWinner {
  id     String @id @default(cuid())
  server Int
  cycle  Int
  userId String @map("user_id")
  nick   String
  votes  Int    @default(0)
  @@unique([server, cycle])
  @@map("election_winners")
}

/* منتور — veterans guide newcomers, both earn daily while bonded */
model MentorLink {
  id         String   @id @default(cuid())
  server     Int
  mentorUid  String   @map("mentor_uid")
  mentorNick String   @map("mentor_nick")
  menteeUid  String   @map("mentee_uid")
  menteeNick String   @map("mentee_nick")
  status     String   @default("pending") /* pending|active|ended */
  days       Int      @default(0)
  lastDay    String?  @map("last_day")
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([mentorUid, status])
  @@index([menteeUid, status])
  @@map("mentor_links")
}
/* open mentor offers by veterans */
model MentorOffer {
  userId    String   @id @map("user_id")
  server    Int
  nick      String
  bio       String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("mentor_offers")
}

/* اتحادها — real multiplayer alliances with tag, member cap and collective power */
model Alliance {
  id        String   @id @default(cuid())
  server    Int
  name      String
  tag       String
  ownerUid  String   @map("owner_uid")
  ownerNick String   @map("owner_nick")
  createdAt DateTime @default(now()) @map("created_at")

  members AllianceMember[]

  @@unique([server, tag])
  @@map("alliances")
}
model AllianceMember {
  id         String   @id @default(cuid())
  allianceId String   @map("alliance_id")
  userId     String   @map("user_id")
  nick       String
  role       String   @default("member") /* owner|member */
  createdAt  DateTime @default(now()) @map("created_at")

  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)

  @@unique([allianceId, userId])
  @@unique([userId])
  @@index([allianceId])
  @@map("alliance_members")
}

/* V36: admin-controlled global switches (KV) — the owner turns events on/off manually */
model GameSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("game_settings")
}

/* V43 — مسیر فصلی (Battle Pass اخلاقی): XP با بازی کردن جمع می‌شود، پله‌ها جایزه می‌دهند */
model SeasonPass {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  season    String   /* 'S2026-09' — ماه میلادی */
  xp        Int      @default(0)
  claimed   Int      @default(0)    /* bitmask پله‌های گرفته‌شده */
  dlog      String   @default("{}") /* شمارنده‌ی روزانه‌ی ماموریت‌ها {date:{key:count}} */
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, season])
  @@map("season_pass")
}

/* V43 — ضدتقلب: گزارش تخلف توسط بازیکن‌ها + بررسی ادمین */
model AbuseReport {
  id         Int      @id @default(autoincrement())
  server     Int      @default(1)
  reporterId String   @map("reporter_id")
  targetNick String   @map("target_nick")
  reason     String
  status     String   @default("open") /* open|cleared|actioned */
  createdAt  DateTime @default(now()) @map("created_at")

  reporter User @relation("AbuseReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetNick, status])
  @@index([reporterId, createdAt])
  @@map("abuse_reports")
}

/* V65 — تالار افتخارات دائمی: هر عنوان فقط از داده‌ی واقعی سرور صادر می‌شود
   (scores / territories / olympic / alliances). نگهدارنده‌ی عنوان + زمان صدور ثبت
   می‌شود تا بخشی از هویت بازیکن باشد؛ تغییر نگهدارنده => خبر hof_new در world_news */
model HofTitle {
  id        String   @id @default(cuid())
  server    Int
  category  String /* conqueror|commander|champion|titan|war_master|diplomat */
  userId    String   @map("user_id")
  nick      String
  detail    String   @default("")
  value     Int      @default(0) /* مقدار سنجش در لحظه‌ی صدور */
  earnedAt  DateTime @map("earned_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([server, category])
  @@map("hof_titles")
}

/* ============ V67 — COUNTRY VIEW ENGINE (Server-Authoritative) ============
   ساخت‌وساز داخل کشور. قواعد سخت:
   - Layout استان‌ها سمت سرور از هندسه‌ی واقعی کشور (GeoJSON) با seed قطعی صادر و ذخیره می‌شود.
   - هیچ هزینه/سطح/زمان/نوعی از کلاینت پذیرفته نمی‌شود — کلاینت فقط رندر می‌کند.
   - تولید lazy-at-read است: در هر cv_state/اقدام، درآمد انباشته‌شده از lastTick
     (سقف ۸ ساعت آفلاین) محاسبه و به استخراج منابع بازی (saves.state.res) اضافه می‌شود.
   - مالکیت کشور پیش از هر اقدام با جدول territories بررسی می‌شود.
   - کشورِ باخته ساختمان‌هایش را نگه می‌دارد (فریز: تولید صفر، مدیریت قفل)؛
     با بازپس‌گیری دوباره فعال می‌شود — هیچ داده‌ای حذف نمی‌شود. */
model CvCountry {
  userId    String   @map("user_id")
  country   String /* English geo name — همان کلید territories.country */
  server    Int      @default(1)
  seed      Int      @default(0) /* seed قطعی layout — یک‌بار صادر و برای همیشه ثابت */
  provinces String   @default("[]") /* JSON: [{i,lat,lng,type,terrain,coastal,slots}] — خروجی سرور */
  tech      String   @default("{}") /* JSON: {eco,mil,log} سطح خطوط فناوری */
  rp        Float    @default(0) /* امتیاز پژوهش (از دانشگاه‌ها) — اعشاری برای انباشت دقیق */
  rem       String   @default("{}") /* باقیمانده‌ی کسری تولید {gold,oil,food} برای انباشت بدون از‌دست‌رفت */
  lastTick  DateTime @default(now()) @map("last_tick")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, country])
  @@index([userId])
  @@map("cv_countries")
}

model CvBuilding {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  country   String
  server    Int       @default(1)
  province  Int /* ایندکس استان در layout صادره‌ی سرور */
  slot      Int /* جایگاه ۰..N-1 در استان — جایگاه‌ها یکتا، بدون همپوشانی بصری */
  type      String /* کلید کاتالوگ سمت سرور (cvCatalog) */
  level     Int       @default(1)
  status    String    @default("building") /* building | active */
  startedAt DateTime  @default(now()) @map("started_at")
  doneAt    DateTime? @map("done_at") /* null = در حال ساخت/ارتقا */
  reqId     String?   @map("req_id") /* Idempotency — کلید یکتای درخواست کلاینت */

  @@unique([userId, country, province, slot])
  @@unique([userId, reqId])
  @@index([userId, country])
  @@map("cv_buildings")
}
