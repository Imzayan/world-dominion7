# ============================================================
# World Dominion — متغیرهای محیطی
# این فایل را به .env کپی کنید (محلی) یا در Vercel → Settings →
# Environment Variables با همان نام‌ها تنظیم کنید.
# ============================================================

# ---------- دیتابیس (تنها متغیر الزامی برای پروداکشن) ----------
# محلی (پیش‌فرض): SQLite — همین خط کافی است و خودکار ساخته می‌شود:
DATABASE_URL=file:../db/custom.db

# پروداکشن (Vercel): یک PostgreSQL رایگان بسازید (Neon / Supabase / Vercel Postgres)
# و رشته‌ی اتصالش را بگذارید. اگر DATABASE_URL با postgres شروع شود،
# اسکریپت build خودکار اسکیمای PostgreSQL را فعال می‌کند:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---------- مدیریت (اختیاری) ----------
# نیک‌هایی که ادمین حساب می‌شوند، جدا با کاما (پیش‌فرض: alireza)
ADMIN_NICKS=alireza

# ---------- پرداخت مایکت (اختیاری — فقط برای شارژ جم واقعی) ----------
# بدون این‌ها بازی کاملاً کار می‌کند؛ فقط خرید واقعی جم غیرفعال است.
MYKET_PACKAGE=com.worlddominion.game
MYKET_CLIENT_ID=
MYKET_CLIENT_SECRET=
MYKET_ACCESS_TOKEN=

# ---------- پرداخت زرین‌پال (اختیاری) ----------
ZARINPAL_MERCHANT_ID=

# ---------- امنیت (اختیاری) ----------
# امضای HMAC آنتی‌چیت المپیاد — یک رشته‌ی تصادفی طولانی بگذارید
OLY_HMAC_SECRET=

# فقط برای تست محلی روی http (هرگز در پروداکشن تنظیم نکنید!)
# COOKIE_SECURE_OFF=1
